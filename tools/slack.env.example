# Slack wake for Bot HQ chat -> Slack #hq-chat (workspace aiworkspace-wih4334)
# Copy to ~/.config/grok-bot-hq/slack.env and chmod 600. Fill EITHER option; webhook wins if both are set.
#
# Option A (simplest): Slack incoming webhook bound to #hq-chat
#   api.slack.com/apps -> Create New App -> From scratch -> pick the workspace -> Incoming Webhooks -> On
#   -> Add New Webhook to Workspace -> choose #hq-chat -> copy the URL here.
SLACK_WEBHOOK_URL=
#
# Option B: bot token + channel ID (chat.postMessage). Bot needs chat:write scope and must be in #hq-chat
#   (/invite @YourApp). Channel ID: open #hq-chat -> channel name -> bottom of About tab (starts with C).
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
