# Instant wake for HQ chat -> Grok Bot routine "hq-chat-instant-wake"
# Copy this file to ~/.config/grok-bot-hq/hq-webhook.env (preferred, chmod 600) or tools/hq-webhook.env,
# then paste the two values from the Grok Bot app: Routines panel -> "hq-chat-instant-wake" -> Webhook trigger
# (the "Webhook URL" and "Sender key" fields, each with a copy button).
WEBHOOK_URL=
WEBHOOK_KEY=
# Optional: header that carries the key. Default "Authorization" (sent as "Bearer <key>").
# Change only if the routine panel says to send the key in a different header.
WEBHOOK_KEY_HEADER=
# Alternative instant wake with no webhook: Grok Bot's own email inbox (e.g. name@mail.grokbot.com) that has an
# email-triggered routine. The bridge asks ntfy.sh to email it on each new HQ message (issue number + link only).
WAKE_EMAIL=
